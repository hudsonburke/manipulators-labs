{
  "name": "Robotic Manipulators Labs",
  "dockerComposeFile": "docker-compose.yml",
  "service": "lab-env",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "forwardPorts": [6080, 5900, 30004, 30002, 29999, 52000, 53000],
  "portsAttributes": {
    "6080": {
      "label": "URSim noVNC (open /vnc.html)",
      "protocol": "http",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "30004": {
      "label": "URSim RTDE",
      "visibility": "private"
    },
    "30002": {
      "label": "URSim primary interface",
      "visibility": "private"
    },
    "29999": {
      "label": "URSim dashboard",
      "visibility": "private"
    },
    "52000": {
      "label": "Swift visualizer",
      "protocol": "http",
      "visibility": "private"
    },
    "53000": {
      "label": "Swift websocket",
      "visibility": "private"
    }
  },
  "postCreateCommand": "uv sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
