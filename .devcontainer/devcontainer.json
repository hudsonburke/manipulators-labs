{
  "name": "Robotic Manipulators Labs",
  "dockerComposeFile": "docker-compose.yml",
  "service": "lab-env",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "forwardPorts": [
    "ursim_cb3:6080",
    "ursim_cb3:5900",
    "ursim_cb3:30004",
    "ursim_cb3:30002",
    "ursim_cb3:29999",
    8000,
    52000,
    53000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Lab 4 browser camera (open in browser)",
      "protocol": "http",
      "onAutoForward": "notify"
    },
    "6080": {
      "label": "URSim noVNC (open /vnc.html)",
      "protocol": "http",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "30004": {
      "label": "URSim RTDE",
      "visibility": "private"
    },
    "30002": {
      "label": "URSim primary interface",
      "visibility": "private"
    },
    "29999": {
      "label": "URSim dashboard",
      "visibility": "private"
    },
    "52000": {
      "label": "Swift HTTP",
      "protocol": "http",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "53000": {
      "label": "Swift WebSocket",
      "protocol": "http",
      "visibility": "private"
    }
  },
  "postCreateCommand": "uv sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
